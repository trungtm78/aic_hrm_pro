<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uat_fixture_list" model="ir.ui.view">
        <field name="name">aic.hrm.uat.fixture.list</field>
        <field name="model">aic.hrm.uat.fixture</field>
        <field name="arch" type="xml">
            <list string="UAT Fixtures">
                <field name="fixture_id"/>
                <field name="applied_on"/>
                <field name="record_count" string="Records"/>
            </list>
        </field>
    </record>

    <record id="view_uat_fixture_form" model="ir.ui.view">
        <field name="name">aic.hrm.uat.fixture.form</field>
        <field name="model">aic.hrm.uat.fixture</field>
        <field name="arch" type="xml">
            <form string="UAT Fixture">
                <header>
                    <button name="action_cleanup" type="object"
                            string="Clean up"
                            confirm="This deletes every record the fixture created, and every fixture built on top of it. Continue?"/>
                </header>
                <sheet>
                    <group>
                        <field name="fixture_id" readonly="1"/>
                        <field name="applied_on"/>
                        <field name="record_count"/>
                    </group>
                    <notebook>
                        <page string="Outputs">
                            <field name="outputs_json" widget="text"/>
                        </page>
                        <page string="Ledger">
                            <field name="record_ids">
                                <list>
                                    <field name="sequence"/>
                                    <field name="res_model"/>
                                    <field name="res_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uat_fixture" model="ir.actions.act_window">
        <field name="name">UAT Fixtures</field>
        <field name="res_model">aic.hrm.uat.fixture</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fixture is applied yet</p>
            <p>Seed the dataset with tools/seed_uat.py, or call
               aic.hrm.uat.fixture.apply_all() from the shell.</p>
        </field>
    </record>

    <!--
        Deliberately under Configuration and nowhere else: this is not a
        stage of the operating loop, it is a testing tool, and it must not
        appear next to work a real user does.
    -->
    <menuitem id="menu_uat_fixture"
              name="UAT Fixtures"
              parent="aic_hrm_base.menu_aic_hrm_config"
              action="action_uat_fixture"
              groups="aic_hrm_base.group_hrm_admin"
              sequence="900"/>
</odoo>
