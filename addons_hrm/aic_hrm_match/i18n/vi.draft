# Vietnamese translation of aic_hrm_match — AIC HRM Pro suite.
# Part of AIC HRM Pro. See LICENSE file for full copyright and licensing details.
#
# Terminology decisions, kept consistent with the rest of the suite:
#   staffing   -> "bố trí nhân sự"  (assigning people to work), not "nhân sự"
#                 alone, which reads as the HR department
#   tag        -> "thẻ"
#   seniority  -> "bậc kinh nghiệm", not "thâm niên": the ladder is about
#                 demonstrated level, not years served
#   rank       -> "thứ bậc" for a position on a ladder
msgid ""
msgstr ""
"Project-Id-Version: aic_hrm_match 19.0.1.0.0\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Staffing"
msgstr "Bố trí nhân sự"

msgid "Staffing: Own profile"
msgstr "Bố trí nhân sự: Hồ sơ cá nhân"

msgid "Staffing: Planner"
msgstr "Bố trí nhân sự: Điều phối"

msgid "Staffing: Administrator"
msgstr "Bố trí nhân sự: Quản trị"

msgid "Staffing: Performance data access"
msgstr "Bố trí nhân sự: Quyền xem dữ liệu hiệu suất"

msgid "Staffing Tag"
msgstr "Thẻ năng lực"

msgid "Staffing Tag Category"
msgstr "Nhóm thẻ năng lực"

msgid "Staffing Seniority Level"
msgstr "Bậc kinh nghiệm"

msgid "Tags"
msgstr "Thẻ"

msgid "Parent Tag"
msgstr "Thẻ cha"

msgid "Child Tags"
msgstr "Thẻ con"

msgid "Complete Name"
msgstr "Tên đầy đủ"

msgid "Is Hierarchical"
msgstr "Có phân cấp"

msgid "Similarity Weight"
msgstr "Trọng số tương đồng"

msgid "Rank"
msgstr "Thứ bậc"

msgid "A tag category with this code already exists."
msgstr "Đã có nhóm thẻ mang mã này."

msgid "A seniority level with this code already exists."
msgstr "Đã có bậc kinh nghiệm mang mã này."

msgid "The tag code %(code)s appears twice in the same batch."
msgstr "Mã thẻ %(code)s xuất hiện hai lần trong cùng một lô."

msgid ""
"The tag code %(code)s is already used in category %(category)s for this "
"company."
msgstr ""
"Mã thẻ %(code)s đã được dùng trong nhóm %(category)s của công ty này."

msgid ""
"%(child)s sits under %(parent)s, which belongs to a different category. "
"Nesting across dimensions makes the distance between two tags meaningless."
msgstr ""
"%(child)s đang nằm dưới %(parent)s, vốn thuộc một nhóm khác. Lồng chéo giữa "
"hai chiều khác nhau làm khoảng cách giữa hai thẻ mất ý nghĩa."

msgid ""
"Category %(name)s: the similarity weight cannot be negative. A negative "
"weight inverts the meaning of the whole dimension - matching the customer's "
"industry would count against the candidate."
msgstr ""
"Nhóm %(name)s: trọng số tương đồng không được âm. Trọng số âm sẽ đảo ngược ý "
"nghĩa của cả chiều đó — trùng ngành của khách hàng lại thành điểm trừ cho ứng "
"viên."

msgid ""
"Seniority %(name)s: rank cannot be negative. Ranks are compared directly, so "
"a negative one would sort below having no seniority recorded at all."
msgstr ""
"Bậc %(name)s: thứ bậc không được âm. Thứ bậc được so sánh trực tiếp, nên giá "
"trị âm sẽ xếp thấp hơn cả trường hợp chưa ghi nhận bậc nào."

msgid ""
"Stable identifier used by imports and by scorer configuration. Changing it "
"breaks references; add a new category instead."
msgstr ""
"Định danh ổn định dùng cho nhập liệu và cấu hình chấm điểm. Đổi mã sẽ làm hỏng "
"các tham chiếu; hãy thêm nhóm mới thay vì sửa."

msgid ""
"How much this dimension counts when comparing a person's history against a "
"request. Industry overlap usually matters less than technology overlap, and "
"how much less is a business decision."
msgstr ""
"Chiều này được tính bao nhiêu khi đối chiếu lịch sử của một người với một nhu "
"cầu. Trùng ngành thường ít quan trọng hơn trùng công nghệ, và ít hơn bao nhiêu "
"là quyết định của doanh nghiệp."

msgid ""
"Whether tags in this category form a tree. Technologies nest (React under "
"Frontend); industries usually do not."
msgstr ""
"Thẻ trong nhóm này có tạo thành cây hay không. Công nghệ thì có lồng nhau "
"(React nằm dưới Frontend); ngành nghề thường thì không."

msgid ""
"Leave empty to share the tag across every company. A company value makes it "
"private to that company."
msgstr ""
"Để trống nếu muốn dùng chung thẻ cho mọi công ty. Điền công ty thì thẻ chỉ "
"thuộc riêng công ty đó."

msgid ""
"Position on the ladder. Only the ordering matters, so leave gaps (10, 20, 30) "
"and a grade can be inserted later without renumbering everything below it."
msgstr ""
"Vị trí trên thang bậc. Chỉ thứ tự là quan trọng, nên hãy chừa khoảng cách "
"(10, 20, 30) để sau này chèn thêm một bậc mà không phải đánh số lại toàn bộ "
"phía dưới."

# --- Generic field labels. Translated in full, matching the rest of the suite:
#     a screen that is 95% Vietnamese with "Created on" in the corner reads as
#     unfinished, and aic_hrm_base sets the precedent at 176/176.

msgid "Active"
msgstr "Đang dùng"

msgid "Category"
msgstr "Nhóm"

msgid "Code"
msgstr "Mã"

msgid "Color"
msgstr "Màu"

msgid "Company"
msgstr "Công ty"

msgid "Created by"
msgstr "Người tạo"

msgid "Created on"
msgstr "Ngày tạo"

msgid "Display Name"
msgstr "Tên hiển thị"

msgid "ID"
msgstr "ID"

msgid "Last Updated by"
msgstr "Người cập nhật cuối"

msgid "Last Updated on"
msgstr "Ngày cập nhật cuối"

msgid "Name"
msgstr "Tên"

msgid "Parent Path"
msgstr "Đường dẫn cha"

msgid "Sequence"
msgstr "Thứ tự"

# --- Group descriptions shown in Settings > Users.

msgid ""
"Maintains their own capability profile and\n"
"            certifications, and sees their own standing in a ranking when the\n"
"            policy allows it. Never sees a colleague's score."
msgstr ""
"Tự duy trì hồ sơ năng lực và chứng chỉ của mình, và xem được vị trí của chính "
"mình trong một lần xếp hạng nếu chính sách cho phép. Không bao giờ thấy điểm "
"của đồng nghiệp."

msgid ""
"Raises staffing requests, runs rankings, verifies\n"
"            certifications, records decisions and books people. Sees candidate\n"
"            scores, but not the contribution of criteria flagged as sensitive\n"
"            unless they also hold Performance Data Access."
msgstr ""
"Tạo nhu cầu nhân sự, chạy xếp hạng, xác thực chứng chỉ, ghi quyết định và đặt "
"lịch cho nhân sự. Thấy điểm của ứng viên, nhưng không thấy phần đóng góp của "
"các tiêu chí được đánh dấu nhạy cảm, trừ khi đồng thời có quyền Xem dữ liệu "
"hiệu suất."

msgid ""
"Owns the criteria catalogue and the scoring\n"
"            policies, the cost and billing rates, the identity mapping behind\n"
"            blind ranking, and the personal-data erasure tool."
msgstr ""
"Sở hữu danh mục tiêu chí và các chính sách chấm điểm, đơn giá chi phí và đơn "
"giá bán, bảng ánh xạ danh tính phía sau cơ chế chấm ẩn danh, và công cụ xoá dữ "
"liệu cá nhân."

msgid ""
"Orthogonal to the three tiers above, not a rung on\n"
"            them. Grants the right to read the contribution of criteria marked\n"
"            sensitive - typically appraisal-derived scores. A planner without it\n"
"            still ranks candidates; they simply never see those figures."
msgstr ""
"Trực giao với ba bậc ở trên, không phải một nấc trong đó. Cấp quyền đọc phần "
"đóng góp của các tiêu chí được đánh dấu nhạy cảm — thường là điểm suy ra từ "
"đánh giá hiệu suất. Người điều phối không có quyền này vẫn xếp hạng được ứng "
"viên; họ chỉ không bao giờ thấy các con số đó."

# --- Skill compatibility service (CP1c). The shim columns only carry data on
#     Odoo 18; the labels still ship translated because a customer on 18 sees
#     them on the skill form.

msgid "Staffing Skill Compatibility Service"
msgstr "Dịch vụ tương thích kỹ năng"

msgid "Skill Type"
msgstr "Loại kỹ năng"

msgid "Skill level for employee"
msgstr "Mức kỹ năng của nhân viên"

msgid "Certification (staffing)"
msgstr "Chứng chỉ (bố trí nhân sự)"

msgid "Valid From (staffing)"
msgstr "Hiệu lực từ (bố trí nhân sự)"

msgid "Valid To (staffing)"
msgstr "Hiệu lực đến (bố trí nhân sự)"

msgid "End of the validity period; empty means open-ended."
msgstr "Ngày hết hiệu lực; để trống nghĩa là vô thời hạn."

msgid ""
"Start of the period this skill or certificate is valid for. Used only where "
"the Odoo release does not model validity itself."
msgstr ""
"Ngày bắt đầu có hiệu lực của kỹ năng hoặc chứng chỉ này. Chỉ dùng ở những bản "
"Odoo chưa tự quản lý thời hạn hiệu lực."

msgid ""
"Whether skills of this type expire and therefore have to cover the whole of a "
"booking. Used only where the Odoo release does not model certifications "
"itself; see the staffing compatibility service."
msgstr ""
"Kỹ năng thuộc loại này có hết hạn hay không, và do đó có phải phủ trọn khoảng "
"thời gian đặt lịch hay không. Chỉ dùng ở những bản Odoo chưa tự quản lý chứng "
"chỉ; xem dịch vụ tương thích kỹ năng."
