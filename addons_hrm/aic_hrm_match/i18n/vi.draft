# Vietnamese translation of aic_hrm_match — AIC HRM Pro suite.
# Part of AIC HRM Pro. See LICENSE file for full copyright and licensing details.
#
# Terminology decisions, kept consistent with the rest of the suite:
#   staffing   -> "bố trí nhân sự"  (assigning people to work), not "nhân sự"
#                 alone, which reads as the HR department
#   tag        -> "thẻ"
#   seniority  -> "bậc kinh nghiệm", not "thâm niên": the ladder is about
#                 demonstrated level, not years served
#   rank       -> "thứ bậc" for a position on a ladder
msgid ""
msgstr ""
"Project-Id-Version: aic_hrm_match 19.0.1.0.0\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Staffing"
msgstr "Bố trí nhân sự"

msgid "Staffing: Own profile"
msgstr "Bố trí nhân sự: Hồ sơ cá nhân"

msgid "Staffing: Planner"
msgstr "Bố trí nhân sự: Điều phối"

msgid "Staffing: Administrator"
msgstr "Bố trí nhân sự: Quản trị"

msgid "Staffing: Performance data access"
msgstr "Bố trí nhân sự: Quyền xem dữ liệu hiệu suất"

msgid "Staffing Tag"
msgstr "Thẻ năng lực"

msgid "Staffing Tag Category"
msgstr "Nhóm thẻ năng lực"

msgid "Staffing Seniority Level"
msgstr "Bậc kinh nghiệm"

msgid "Tags"
msgstr "Thẻ"

msgid "Parent Tag"
msgstr "Thẻ cha"

msgid "Child Tags"
msgstr "Thẻ con"

msgid "Complete Name"
msgstr "Tên đầy đủ"

msgid "Is Hierarchical"
msgstr "Có phân cấp"

msgid "Similarity Weight"
msgstr "Trọng số tương đồng"

msgid "Rank"
msgstr "Thứ bậc"

msgid "A tag category with this code already exists."
msgstr "Đã có nhóm thẻ mang mã này."

msgid "A seniority level with this code already exists."
msgstr "Đã có bậc kinh nghiệm mang mã này."

msgid "The tag code %(code)s appears twice in the same batch."
msgstr "Mã thẻ %(code)s xuất hiện hai lần trong cùng một lô."

msgid ""
"The tag code %(code)s is already used in category %(category)s for this "
"company."
msgstr ""
"Mã thẻ %(code)s đã được dùng trong nhóm %(category)s của công ty này."

msgid ""
"%(child)s sits under %(parent)s, which belongs to a different category. "
"Nesting across dimensions makes the distance between two tags meaningless."
msgstr ""
"%(child)s đang nằm dưới %(parent)s, vốn thuộc một nhóm khác. Lồng chéo giữa "
"hai chiều khác nhau làm khoảng cách giữa hai thẻ mất ý nghĩa."

msgid ""
"Category %(name)s: the similarity weight cannot be negative. A negative "
"weight inverts the meaning of the whole dimension - matching the customer's "
"industry would count against the candidate."
msgstr ""
"Nhóm %(name)s: trọng số tương đồng không được âm. Trọng số âm sẽ đảo ngược ý "
"nghĩa của cả chiều đó — trùng ngành của khách hàng lại thành điểm trừ cho ứng "
"viên."

msgid ""
"Seniority %(name)s: rank cannot be negative. Ranks are compared directly, so "
"a negative one would sort below having no seniority recorded at all."
msgstr ""
"Bậc %(name)s: thứ bậc không được âm. Thứ bậc được so sánh trực tiếp, nên giá "
"trị âm sẽ xếp thấp hơn cả trường hợp chưa ghi nhận bậc nào."

msgid ""
"Stable identifier used by imports and by scorer configuration. Changing it "
"breaks references; add a new category instead."
msgstr ""
"Định danh ổn định dùng cho nhập liệu và cấu hình chấm điểm. Đổi mã sẽ làm hỏng "
"các tham chiếu; hãy thêm nhóm mới thay vì sửa."

msgid ""
"How much this dimension counts when comparing a person's history against a "
"request. Industry overlap usually matters less than technology overlap, and "
"how much less is a business decision."
msgstr ""
"Chiều này được tính bao nhiêu khi đối chiếu lịch sử của một người với một nhu "
"cầu. Trùng ngành thường ít quan trọng hơn trùng công nghệ, và ít hơn bao nhiêu "
"là quyết định của doanh nghiệp."

msgid ""
"Whether tags in this category form a tree. Technologies nest (React under "
"Frontend); industries usually do not."
msgstr ""
"Thẻ trong nhóm này có tạo thành cây hay không. Công nghệ thì có lồng nhau "
"(React nằm dưới Frontend); ngành nghề thường thì không."

msgid ""
"Leave empty to share the tag across every company. A company value makes it "
"private to that company."
msgstr ""
"Để trống nếu muốn dùng chung thẻ cho mọi công ty. Điền công ty thì thẻ chỉ "
"thuộc riêng công ty đó."

msgid ""
"Position on the ladder. Only the ordering matters, so leave gaps (10, 20, 30) "
"and a grade can be inserted later without renumbering everything below it."
msgstr ""
"Vị trí trên thang bậc. Chỉ thứ tự là quan trọng, nên hãy chừa khoảng cách "
"(10, 20, 30) để sau này chèn thêm một bậc mà không phải đánh số lại toàn bộ "
"phía dưới."

# --- Generic field labels. Translated in full, matching the rest of the suite:
#     a screen that is 95% Vietnamese with "Created on" in the corner reads as
#     unfinished, and aic_hrm_base sets the precedent at 176/176.

msgid "Active"
msgstr "Đang dùng"

msgid "Category"
msgstr "Nhóm"

msgid "Code"
msgstr "Mã"

msgid "Color"
msgstr "Màu"

msgid "Company"
msgstr "Công ty"

msgid "Created by"
msgstr "Người tạo"

msgid "Created on"
msgstr "Ngày tạo"

msgid "Display Name"
msgstr "Tên hiển thị"

msgid "ID"
msgstr "ID"

msgid "Last Updated by"
msgstr "Người cập nhật cuối"

msgid "Last Updated on"
msgstr "Ngày cập nhật cuối"

msgid "Name"
msgstr "Tên"

msgid "Parent Path"
msgstr "Đường dẫn cha"

msgid "Sequence"
msgstr "Thứ tự"

# --- Group descriptions shown in Settings > Users.

msgid ""
"Maintains their own capability profile and\n"
"            certifications, and sees their own standing in a ranking when the\n"
"            policy allows it. Never sees a colleague's score."
msgstr ""
"Tự duy trì hồ sơ năng lực và chứng chỉ của mình, và xem được vị trí của chính "
"mình trong một lần xếp hạng nếu chính sách cho phép. Không bao giờ thấy điểm "
"của đồng nghiệp."

msgid ""
"Raises staffing requests, runs rankings, verifies\n"
"            certifications, records decisions and books people. Sees candidate\n"
"            scores, but not the contribution of criteria flagged as sensitive\n"
"            unless they also hold Performance Data Access."
msgstr ""
"Tạo nhu cầu nhân sự, chạy xếp hạng, xác thực chứng chỉ, ghi quyết định và đặt "
"lịch cho nhân sự. Thấy điểm của ứng viên, nhưng không thấy phần đóng góp của "
"các tiêu chí được đánh dấu nhạy cảm, trừ khi đồng thời có quyền Xem dữ liệu "
"hiệu suất."

msgid ""
"Owns the criteria catalogue and the scoring\n"
"            policies, the cost and billing rates, the identity mapping behind\n"
"            blind ranking, and the personal-data erasure tool."
msgstr ""
"Sở hữu danh mục tiêu chí và các chính sách chấm điểm, đơn giá chi phí và đơn "
"giá bán, bảng ánh xạ danh tính phía sau cơ chế chấm ẩn danh, và công cụ xoá dữ "
"liệu cá nhân."

msgid ""
"Orthogonal to the three tiers above, not a rung on\n"
"            them. Grants the right to read the contribution of criteria marked\n"
"            sensitive - typically appraisal-derived scores. A planner without it\n"
"            still ranks candidates; they simply never see those figures."
msgstr ""
"Trực giao với ba bậc ở trên, không phải một nấc trong đó. Cấp quyền đọc phần "
"đóng góp của các tiêu chí được đánh dấu nhạy cảm — thường là điểm suy ra từ "
"đánh giá hiệu suất. Người điều phối không có quyền này vẫn xếp hạng được ứng "
"viên; họ chỉ không bao giờ thấy các con số đó."

# --- Skill compatibility service (CP1c). The shim columns only carry data on
#     Odoo 18; the labels still ship translated because a customer on 18 sees
#     them on the skill form.

msgid "Staffing Skill Compatibility Service"
msgstr "Dịch vụ tương thích kỹ năng"

msgid "Skill Type"
msgstr "Loại kỹ năng"

msgid "Skill level for employee"
msgstr "Mức kỹ năng của nhân viên"

msgid "Certification (staffing)"
msgstr "Chứng chỉ (bố trí nhân sự)"

msgid "Valid From (staffing)"
msgstr "Hiệu lực từ (bố trí nhân sự)"

msgid "Valid To (staffing)"
msgstr "Hiệu lực đến (bố trí nhân sự)"

msgid "End of the validity period; empty means open-ended."
msgstr "Ngày hết hiệu lực; để trống nghĩa là vô thời hạn."

msgid ""
"Start of the period this skill or certificate is valid for. Used only where "
"the Odoo release does not model validity itself."
msgstr ""
"Ngày bắt đầu có hiệu lực của kỹ năng hoặc chứng chỉ này. Chỉ dùng ở những bản "
"Odoo chưa tự quản lý thời hạn hiệu lực."

msgid ""
"Whether skills of this type expire and therefore have to cover the whole of a "
"booking. Used only where the Odoo release does not model certifications "
"itself; see the staffing compatibility service."
msgstr ""
"Kỹ năng thuộc loại này có hết hạn hay không, và do đó có phải phủ trọn khoảng "
"thời gian đặt lịch hay không. Chỉ dùng ở những bản Odoo chưa tự quản lý chứng "
"chỉ; xem dịch vụ tương thích kỹ năng."

# --- Allocation and the availability service (CP2a).
#     "booking" -> "đặt lịch" (the act) / "lịch đã đặt" (the record).
#     "blocking" -> "chiếm chỗ": it consumes availability, it does not forbid.

msgid "Staffing Allocation"
msgstr "Lịch đã đặt"

msgid "Staffing Availability Service"
msgstr "Dịch vụ tính thời gian rảnh"

msgid "Employee"
msgstr "Nhân viên"

msgid "Resource"
msgstr "Nguồn lực"

msgid "Date Start"
msgstr "Bắt đầu"

msgid "Date End"
msgstr "Kết thúc"

msgid "Allocated Hours"
msgstr "Số giờ cam kết"

msgid "Booking Type"
msgstr "Loại đặt lịch"

msgid "Soft (pencilled in)"
msgstr "Tạm giữ chỗ"

msgid "Hard (committed)"
msgstr "Đã cam kết"

msgid "Actual (already worked)"
msgstr "Thực tế đã làm"

msgid "State"
msgstr "Trạng thái"

msgid "Draft"
msgstr "Nháp"

msgid "Proposed"
msgstr "Đã đề xuất"

msgid "Confirmed"
msgstr "Đã xác nhận"

msgid "Done"
msgstr "Hoàn thành"

msgid "Cancelled"
msgstr "Đã huỷ"

msgid "Is Blocking"
msgstr "Chiếm chỗ"

msgid "Task"
msgstr "Nhiệm vụ"

msgid "Task Ref Snapshot"
msgstr "Ảnh chụp tham chiếu nhiệm vụ"

msgid "Project"
msgstr "Dự án"

msgid "Partner"
msgstr "Đối tác"

msgid "Source"
msgstr "Nguồn"

msgid "Entered by hand"
msgstr "Nhập tay"

msgid "From a staffing decision"
msgstr "Từ quyết định bố trí"

msgid "Derived from a task"
msgstr "Suy ra từ nhiệm vụ"

msgid "Imported"
msgstr "Nhập khẩu dữ liệu"

msgid "From a connector"
msgstr "Từ module cầu nối"

msgid "Role Note"
msgstr "Ghi chú vai trò"

msgid "A booking cannot commit negative hours."
msgstr "Không thể đặt lịch với số giờ âm."

msgid "A booking must end after it starts. Check %(name)s."
msgstr "Lịch phải kết thúc sau khi bắt đầu. Kiểm tra lại %(name)s."

msgid ""
"Effort committed inside the window. Prorated when only part of the booking "
"falls inside the period being looked at."
msgstr ""
"Số giờ cam kết trong khoảng thời gian này. Được chia theo tỷ lệ khi chỉ một "
"phần của lịch nằm trong khoảng đang xét."

msgid ""
"The task this booking came from, captured at creation so the trail survives "
"the task being deleted."
msgstr ""
"Nhiệm vụ sinh ra lịch này, được chụp lại lúc tạo để dấu vết vẫn còn kể cả khi "
"nhiệm vụ bị xoá."

msgid ""
"Whether this booking consumes availability. Stored so the engine can filter "
"on it in SQL rather than in Python."
msgstr ""
"Lịch này có chiếm thời gian rảnh hay không. Được lưu để engine lọc ngay trong "
"SQL thay vì trong Python."

# --- Clash prevention (CP2b).

msgid "Companies"
msgstr "Công ty"

msgid "Over-allocation tolerance"
msgstr "Mức cho phép vượt công suất"

msgid ""
"How far past somebody's working hours a booking may go, as a fraction. 0.0 "
"refuses anything beyond capacity; 0.1 allows ten per cent. Some organisations "
"plan deliberately above capacity and absorb it, which is a business decision "
"rather than something to hard-code as allowed or forbidden."
msgstr ""
"Được phép đặt lịch vượt quá số giờ làm việc của một người bao nhiêu, tính "
"theo tỷ lệ. 0.0 là từ chối mọi phần vượt công suất; 0.1 là cho phép vượt 10%. "
"Một số tổ chức chủ động lập kế hoạch vượt công suất rồi tự hấp thụ — đó là "
"quyết định của doanh nghiệp, không phải thứ nên cố định cứng trong mã nguồn."

msgid ""
"%(employee)s is committed to %(committed).1f hours between %(start)s and "
"%(end)s but only has %(capacity).1f working hours there. Clashing bookings: "
"%(ids)s."
msgstr ""
"%(employee)s đã bị cam kết %(committed).1f giờ trong khoảng %(start)s đến "
"%(end)s, trong khi chỉ có %(capacity).1f giờ làm việc ở đó. Các lịch đang "
"đụng nhau: %(ids)s."

# --- Wording reused verbatim from the rest of the suite, so the same
#     concept does not acquire two names on adjacent screens.

msgid "Action Needed"
msgstr "Cần xử lý"

msgid "Activities"
msgstr "Hoạt động"

msgid "Activity Exception Decoration"
msgstr "Trang trí ngoại lệ hoạt động"

msgid "Activity State"
msgstr "Trạng thái hoạt động"

msgid "Activity Type Icon"
msgstr "Biểu tượng loại hoạt động"

msgid "Attachment Count"
msgstr "Số tệp đính kèm"

msgid "Closed"
msgstr "Đã đóng"

msgid "Customer"
msgstr "Khách hàng"

msgid "Followers"
msgstr "Người theo dõi"

msgid "Followers (Partners)"
msgstr "Người theo dõi (đối tác)"

msgid "Font awesome icon e.g. fa-tasks"
msgstr "Biểu tượng Font Awesome, ví dụ fa-tasks"

msgid "Has Message"
msgstr "Có tin nhắn"

msgid "Icon"
msgstr "Biểu tượng"

msgid "Icon to indicate an exception activity."
msgstr "Biểu tượng cho biết hoạt động ngoại lệ."

msgid "If checked, new messages require your attention."
msgstr "Nếu bật, tin nhắn mới cần bạn xử lý."

msgid "If checked, some messages have a delivery error."
msgstr "Nếu bật, có tin nhắn gặp lỗi gửi."

msgid "Is Follower"
msgstr "Đang theo dõi"

msgid "Message Delivery error"
msgstr "Lỗi gửi tin nhắn"

msgid "Messages"
msgstr "Tin nhắn"

msgid "My Activity Deadline"
msgstr "Hạn hoạt động của tôi"

msgid "Next Activity Deadline"
msgstr "Hạn hoạt động kế tiếp"

msgid "Next Activity Summary"
msgstr "Tóm tắt hoạt động kế tiếp"

msgid "Next Activity Type"
msgstr "Loại hoạt động kế tiếp"

msgid "Number of Actions"
msgstr "Số hành động"

msgid "Number of errors"
msgstr "Số lỗi"

msgid "Number of messages requiring action"
msgstr "Số tin nhắn cần xử lý"

msgid "Number of messages with delivery error"
msgstr "Số tin nhắn bị lỗi gửi"

msgid "Priority"
msgstr "Ưu tiên"

msgid "Ratings"
msgstr "Đánh giá"

msgid "Request"
msgstr "Yêu cầu"

msgid "Responsible User"
msgstr "Người phụ trách"

msgid "SMS Delivery error"
msgstr "Lỗi gửi SMS"

msgid "Status based on activities\nOverdue: Due date is already passed\nToday: Activity date is today\nPlanned: Future activities."
msgstr "Trạng thái theo hoạt động\nQuá hạn: đã qua ngày đến hạn\nHôm nay: hoạt động đến hạn hôm nay\nĐã lên lịch: hoạt động trong tương lai."

msgid "Type of the exception activity on record."
msgstr "Loại hoạt động ngoại lệ trên bản ghi."

msgid "Website Messages"
msgstr "Tin nhắn từ website"

msgid "Website communication history"
msgstr "Lịch sử trao đổi qua website"

msgid "Weight"
msgstr "Trọng số"


# --- Demand side: request, slot, staffing profile (CP2c).
#   slot      -> "vị trí cần bố trí": a seat to fill, not a period of time
#   headcount -> "số người cần"

msgid "Staffing Request"
msgstr "Nhu cầu bố trí nhân sự"

msgid "Staffing Slot"
msgstr "Vị trí cần bố trí"

msgid "Staffing Slot Skill Requirement"
msgstr "Kỹ năng yêu cầu cho vị trí"

msgid "Staffing Profile"
msgstr "Hồ sơ bố trí nhân sự"

msgid "Reference"
msgstr "Số hiệu"

msgid "Request Type"
msgstr "Loại nhu cầu"

msgid "From a task"
msgstr "Từ một nhiệm vụ"

msgid "A role on a project"
msgstr "Một vai trò trong dự án"

msgid "Standalone need"
msgstr "Nhu cầu độc lập"

msgid "Requesting company"
msgstr "Công ty đặt nhu cầu"

msgid "Companies to staff from"
msgstr "Các công ty được lấy nhân sự"

msgid "Resource Company"
msgstr "Công ty của nhân sự"

msgid "Headcount"
msgstr "Số người cần"

msgid "Slot"
msgstr "Vị trí"

msgid "Slots"
msgstr "Các vị trí"

msgid "Skills required"
msgstr "Kỹ năng yêu cầu"

msgid "Required Hours"
msgstr "Số giờ cần"

msgid "Fte Ratio"
msgstr "Tỷ lệ toàn thời gian"

msgid "Allow Partial Availability"
msgstr "Chấp nhận rảnh một phần"

msgid "Max Hourly Cost"
msgstr "Trần chi phí theo giờ"

msgid "Assigned Employee"
msgstr "Nhân sự được chọn"

msgid "Requirement"
msgstr "Mức yêu cầu"

msgid "Mandatory"
msgstr "Bắt buộc"

msgid "Important"
msgstr "Quan trọng"

msgid "Nice to have"
msgstr "Có thì tốt"

msgid "Min Level"
msgstr "Mức tối thiểu"

msgid "Min Level Progress"
msgstr "Mức tối thiểu (thang 0-100)"

msgid "Stretch Allowed"
msgstr "Cho phép nới ngưỡng"

msgid "Skill"
msgstr "Kỹ năng"

msgid "Seniority"
msgstr "Bậc kinh nghiệm"

msgid "Job"
msgstr "Vị trí công việc"

msgid "Currency"
msgstr "Tiền tệ"

msgid "Timezone"
msgstr "Múi giờ"

msgid "Work Location"
msgstr "Nơi làm việc"

msgid "Working Hours"
msgstr "Lịch làm việc"

msgid "Willing To Travel"
msgstr "Sẵn sàng đi công tác"

msgid "Staffable"
msgstr "Có thể bố trí"

msgid "Opted out"
msgstr "Đã xin không tham gia"

msgid "Opt Out Reason"
msgstr "Lý do không tham gia"

msgid "Available From"
msgstr "Rảnh từ ngày"

msgid "Experience Start Date"
msgstr "Bắt đầu làm nghề từ"

msgid "Cost Hourly"
msgstr "Chi phí theo giờ"

msgid "Billing Rate Hourly"
msgstr "Đơn giá bán theo giờ"

msgid "Max Concurrent Requests"
msgstr "Số nhu cầu tối đa cùng lúc"

msgid "Rotation Epoch"
msgstr "Vòng xoay"

msgid "Normal"
msgstr "Bình thường"

msgid "Urgent"
msgstr "Khẩn"

msgid "Ranked"
msgstr "Đã xếp hạng"

msgid "Decided"
msgstr "Đã quyết định"

msgid "Staffed"
msgstr "Đã bố trí xong"

msgid "New"
msgstr "Mới"

msgid "%(name)s must end after it starts."
msgstr "%(name)s phải kết thúc sau khi bắt đầu."

msgid "A slot cannot require negative hours."
msgstr "Một vị trí không thể yêu cầu số giờ âm."

msgid "A slot cannot require a negative share of somebody's time."
msgstr "Một vị trí không thể yêu cầu tỷ lệ thời gian âm."

msgid "That staffing reference is already used in this company."
msgstr "Số hiệu nhu cầu này đã được dùng trong công ty."

msgid "Mandatory eliminates; the others only move the score."
msgstr "Mức bắt buộc thì loại thẳng; hai mức còn lại chỉ làm thay đổi điểm."

msgid "Filled from the decision, never typed."
msgstr "Được điền từ quyết định, không bao giờ gõ tay."

msgid "Internal cost per hour, used by the cost-fit criterion."
msgstr "Chi phí nội bộ theo giờ, dùng cho tiêu chí phù hợp chi phí."

msgid ""
"%(skill)s is already required on this slot. Raise the minimum level instead "
"of listing it twice."
msgstr ""
"%(skill)s đã được yêu cầu ở vị trí này rồi. Hãy nâng mức tối thiểu thay vì "
"khai hai lần."

msgid ""
"Level %(level)s belongs to %(other)s, not to %(skill)s. Comparing across two "
"scales makes the gap meaningless."
msgstr ""
"Mức %(level)s thuộc %(other)s chứ không thuộc %(skill)s. So sánh giữa hai "
"thang khác nhau làm khoảng cách mất ý nghĩa."

msgid ""
"%(names)s already carry staffing decisions. Archive them instead of deleting "
"- the ranking behind a decision is the only record of why the other "
"candidates were not chosen."
msgstr ""
"%(names)s đã gắn với quyết định bố trí nhân sự. Hãy lưu trữ thay vì xoá — bảng "
"xếp hạng phía sau một quyết định là bằng chứng duy nhất cho việc vì sao các "
"ứng viên còn lại không được chọn."

msgid ""
"The minimum level expressed on the 0-100 scale the engine compares against."
msgstr ""
"Mức tối thiểu quy về thang 0-100 mà engine dùng để so sánh."

msgid ""
"How many staffing requests this person may be committed to at once. Zero "
"means no limit."
msgstr ""
"Người này được cam kết tối đa bao nhiêu nhu cầu cùng lúc. Số 0 nghĩa là không "
"giới hạn."

msgid ""
"Quoted in meetings, and the key the tie-break is salted with so re-running a "
"request produces the same order."
msgstr ""
"Dùng để nhắc trong cuộc họp, đồng thời là khoá trộn của cơ chế phá hoà — nhờ "
"đó chạy lại cùng một nhu cầu vẫn ra đúng thứ tự cũ."

msgid ""
"How many people this request needs. Derived from the slots rather than typed, "
"so the two cannot disagree."
msgstr ""
"Nhu cầu này cần bao nhiêu người. Suy ra từ danh sách vị trí chứ không gõ tay, "
"nên hai con số không thể lệch nhau."

msgid ""
"Which companies candidates may come from. Defaults to the requesting company; "
"widening it is what cross-company staffing means, and it is deliberately "
"opt-in."
msgstr ""
"Ứng viên được phép đến từ những công ty nào. Mặc định là công ty đặt nhu cầu; "
"mở rộng ra chính là bố trí nhân sự liên công ty, và đó là lựa chọn phải bật "
"chủ động."

msgid ""
"Effort this seat needs. Belongs to the slot, not the request: two seats on "
"one engagement rarely need the same effort."
msgstr ""
"Khối lượng công việc của vị trí này. Thuộc về vị trí chứ không thuộc nhu cầu: "
"hai vị trí trong cùng một việc hiếm khi cần khối lượng như nhau."

msgid ""
"Used instead of required hours when the need is expressed as a share of "
"somebody's time."
msgstr ""
"Dùng thay cho số giờ khi nhu cầu được diễn đạt theo tỷ lệ thời gian của một "
"người."

msgid ""
"Accept somebody who can cover most of the effort rather than all of it. Off "
"by default: a half-available person on a full-time seat is a staffing problem "
"deferred, not solved."
msgstr ""
"Chấp nhận người chỉ kham được phần lớn khối lượng thay vì toàn bộ. Mặc định "
"tắt: xếp một người rảnh nửa thời gian vào vị trí toàn thời gian là hoãn vấn đề "
"lại chứ không giải quyết nó."

msgid ""
"Allow somebody slightly below the minimum to be considered, as a development "
"opportunity. Off by default: relaxing a mandatory requirement has to be a "
"deliberate act on the requirement itself, not a side effect of a fairness "
"setting elsewhere."
msgstr ""
"Cho phép xét cả người hơi dưới mức tối thiểu, coi như cơ hội phát triển. Mặc "
"định tắt: nới một yêu cầu bắt buộc phải là hành động có chủ đích ngay trên "
"chính yêu cầu đó, không phải hệ quả phụ của một thiết lập công bằng ở nơi khác."

msgid ""
"Whether this person may appear in a shortlist at all. Turn it off for roles "
"that are never project-staffed rather than deleting the record."
msgstr ""
"Người này có được xuất hiện trong danh sách rút gọn hay không. Hãy tắt với "
"những vị trí không bao giờ bố trí theo dự án, thay vì xoá bản ghi."

msgid ""
"Excluded from ranking at the person's own request. Recorded rather than "
"enforced by removing their data, so a planner can see that somebody was "
"excluded and why."
msgstr ""
"Bị loại khỏi xếp hạng theo nguyện vọng của chính người đó. Được ghi nhận thay "
"vì thực thi bằng cách xoá dữ liệu, để người điều phối thấy được ai bị loại và "
"vì sao."

msgid ""
"Earliest date this person can take new work. Somebody joining next month is a "
"real candidate for work that starts after that."
msgstr ""
"Ngày sớm nhất người này có thể nhận việc mới. Người tháng sau mới vào vẫn là "
"ứng viên thật cho công việc bắt đầu sau đó."

msgid ""
"When this person started working in the field, which is not the same as when "
"they joined this company."
msgstr ""
"Người này bắt đầu làm nghề từ khi nào — khác với ngày vào công ty này."

msgid ""
"This field is used in order to define in which timezone the resources will "
"work."
msgstr ""
"Trường này xác định nguồn lực làm việc theo múi giờ nào."

# --- Reused from the suite glossary (CP2d).

msgid "Rejected"
msgstr "Đã từ chối"

msgid "Role"
msgstr "Vai trò"


# --- Experience ledger and certificate verification (CP2d).
#   experience entry -> "dòng kinh nghiệm"
#   verify           -> "xác thực" (confirming a claim), not "kiểm tra"

msgid "Staffing Experience Entry"
msgstr "Dòng kinh nghiệm"

msgid "Source Key"
msgstr "Khoá nguồn"

msgid "Source Model"
msgstr "Model nguồn"

msgid "Source Res"
msgstr "Bản ghi nguồn"

msgid "Booking"
msgstr "Lịch đã đặt"

msgid "Timesheet"
msgstr "Chấm công"

msgid "Hours"
msgstr "Số giờ"

msgid "Is Lead Role"
msgstr "Vai trò dẫn dắt"

msgid "Tags at the time"
msgstr "Thẻ tại thời điểm đó"

msgid "Skills used"
msgstr "Kỹ năng đã dùng"

msgid "Outcome Score"
msgstr "Điểm kết quả"

msgid "Outcome Source"
msgstr "Nguồn đánh giá kết quả"

msgid "Recency Weight"
msgstr "Trọng số gần đây"

msgid "Commercial Entity"
msgstr "Pháp nhân thương mại"

msgid "Verification"
msgstr "Xác thực"

msgid "Not submitted"
msgstr "Chưa nộp"

msgid "Awaiting verification"
msgstr "Chờ xác thực"

msgid "Verified"
msgstr "Đã xác thực"

msgid "Verified By"
msgstr "Người xác thực"

msgid "Verified Date"
msgstr "Ngày xác thực"

msgid "Staffing: refresh experience recency"
msgstr "Bố trí nhân sự: làm mới trọng số gần đây"

msgid "An experience entry cannot end before it starts."
msgstr "Một dòng kinh nghiệm không thể kết thúc trước khi bắt đầu."

msgid "An outcome is a score between 0 and 1; %(value)s is outside that."
msgstr "Kết quả là điểm từ 0 đến 1; %(value)s nằm ngoài khoảng đó."

msgid "%(skill)s cannot go from %(current)s to %(target)s."
msgstr "%(skill)s không thể chuyển từ %(current)s sang %(target)s."

msgid ""
"Only a staffing planner may verify or reject a certificate. A certificate "
"confirmed by the person who claimed it attests to nothing."
msgstr ""
"Chỉ người điều phối bố trí nhân sự mới được xác thực hoặc từ chối một chứng "
"chỉ. Chứng chỉ do chính người khai tự xác nhận thì không chứng minh được điều "
"gì."

msgid ""
"Set by the system when somebody verifies. Never accepted from the caller: "
"taking it from vals would let anybody claim a colleague signed off on their "
"certificate."
msgstr ""
"Do hệ thống ghi khi có người xác thực. Không bao giờ nhận từ phía gọi: lấy giá "
"trị này từ dữ liệu gửi lên sẽ cho phép bất kỳ ai khai rằng đồng nghiệp đã ký "
"duyệt chứng chỉ của mình."

msgid ""
"How well it went, from 0 to 1, when something knows. Left empty rather than "
"defaulted: inventing a number here would put a fabricated observation into "
"the customer-affinity score."
msgstr ""
"Việc đó diễn ra tốt đến đâu, thang 0 đến 1, khi có nguồn nào biết được. Để "
"trống thay vì gán mặc định: bịa một con số ở đây là đưa một quan sát không có "
"thật vào điểm thân thuộc khách hàng."

msgid ""
"Stable identity of the record this entry was derived from. Each feeder names "
"its own rows, which is what lets a rebuild run twice without doubling the "
"ledger."
msgstr ""
"Định danh ổn định của bản ghi đã sinh ra dòng này. Mỗi nguồn tự đặt tên cho "
"hàng của mình — nhờ đó dựng lại sổ hai lần vẫn không nhân đôi dữ liệu."

msgid ""
"The customer group. Work for a subsidiary counts towards the parent, which is "
"how a planner thinks about the relationship."
msgstr ""
"Nhóm khách hàng. Việc làm cho công ty con được tính cho cả công ty mẹ — đó là "
"cách người điều phối nghĩ về mối quan hệ này."

msgid ""
"Display-only decay, refreshed nightly. Ranking never reads it; it recomputes "
"decay against the moment the run was frozen."
msgstr ""
"Hệ số suy giảm chỉ để hiển thị, làm mới hằng đêm. Việc xếp hạng không bao giờ "
"đọc nó; engine tự tính lại suy giảm theo mốc thời gian đã đóng băng của lần "
"chạy."
