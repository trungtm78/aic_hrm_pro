#. module: aic_hrm_match
#. odoo-python
#: code:addons/aic_hrm_match/models/aic_hrm_match_tag.py:0
msgid ""
"%(child)s sits under %(parent)s, which belongs to a different category. "
"Nesting across dimensions makes the distance between two tags meaningless."
msgstr ""
"%(child)s đang nằm dưới %(parent)s, vốn thuộc một nhóm khác. Lồng chéo giữa "
"hai chiều khác nhau làm khoảng cách giữa hai thẻ mất ý nghĩa."

#. module: aic_hrm_match
#. odoo-python
#: code:addons/aic_hrm_match/models/aic_hrm_match_allocation.py:0
msgid ""
"%(employee)s is committed to %(committed).1f hours between %(start)s and "
"%(end)s but only has %(capacity).1f working hours there. Clashing bookings: "
"%(ids)s."
msgstr ""
"%(employee)s đã bị cam kết %(committed).1f giờ trong khoảng %(start)s đến "
"%(end)s, trong khi chỉ có %(capacity).1f giờ làm việc ở đó. Các lịch đang "
"đụng nhau: %(ids)s."

#. module: aic_hrm_match
#. odoo-python
