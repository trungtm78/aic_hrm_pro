msgstr "Ngưỡng RAG"

msgid "Target Revisions"
msgstr "Điều chỉnh chỉ tiêu"

msgid "Metric Sources"
msgstr "Nguồn số liệu"

msgid "Metric Allowlist"
msgstr "Danh sách model cho phép"

msgid "Performance Cycle"
msgstr "Chu kỳ hiệu suất"

msgid "Cycle"
msgstr "Chu kỳ"

msgid "Parent Cycle"
msgstr "Chu kỳ cha"

msgid "Sub-cycles"
msgstr "Chu kỳ con"

