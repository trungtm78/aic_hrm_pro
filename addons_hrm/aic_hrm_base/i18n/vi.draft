msgstr "Năm"

msgid "Half-year"
msgstr "Nửa năm"

msgid "Quarter"
msgstr "Quý"

msgid "Month"
msgstr "Tháng"

msgid "Custom period"
msgstr "Kỳ tùy chỉnh"

