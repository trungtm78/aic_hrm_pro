<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="group_hrm_user" model="res.groups">
        <field name="name">Performance: User</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Sees own goals and public goals, records check-ins.</field>
    </record>

    <record id="group_hrm_manager" model="res.groups">
        <field name="name">Performance: Manager</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('group_hrm_user'))]"/>
        <field name="comment">Manages cycles and the goals of their reporting line.</field>
    </record>

    <record id="group_hrm_admin" model="res.groups">
        <field name="name">Performance: Administrator</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('group_hrm_manager'))]"/>
        <field name="comment">Full configuration access, including metric sources.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
