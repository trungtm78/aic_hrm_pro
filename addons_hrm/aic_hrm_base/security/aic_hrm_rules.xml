<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_cycle_company" model="ir.rule">
        <field name="name">Performance cycle: multi-company</field>
        <field name="model_id" ref="model_aic_hrm_cycle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rag_profile_company" model="ir.rule">
        <field name="name">RAG profile: multi-company or shared</field>
        <field name="model_id" ref="model_aic_hrm_rag_profile"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_target_revision_company" model="ir.rule">
        <field name="name">Target revision: multi-company</field>
        <field name="model_id" ref="model_aic_hrm_target_revision"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
