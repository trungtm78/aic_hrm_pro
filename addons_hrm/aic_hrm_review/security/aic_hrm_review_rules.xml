<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reviews: employee reads/writes own (self stage fields guarded in
         python), manager covers reporting line, admin all. -->
    <record id="rule_review_user" model="ir.rule">
        <field name="name">Review: employee sees own</field>
        <field name="model_id" ref="model_aic_hrm_review"/>
        <field name="groups" eval="[(4, ref('aic_hrm_base.group_hrm_user'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_review_manager" model="ir.rule">
        <field name="name">Review: manager covers reporting line</field>
        <field name="model_id" ref="model_aic_hrm_review"/>
        <field name="groups" eval="[(4, ref('aic_hrm_base.group_hrm_manager'))]"/>
        <field name="domain_force">[('employee_id', 'child_of', user.employee_id.ids)]</field>
    </record>

    <record id="rule_review_admin" model="ir.rule">
        <field name="name">Review: admin unrestricted</field>
        <field name="model_id" ref="model_aic_hrm_review"/>
        <field name="groups" eval="[(4, ref('aic_hrm_base.group_hrm_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_review_company" model="ir.rule">
        <field name="name">Review: multi-company</field>
        <field name="model_id" ref="model_aic_hrm_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Feedback requests: the RATER sees their own invitations. The
         reviewee sees none (anonymity); managers see requests of their
         line's reviews but the rater field stays admin-only. -->
    <record id="rule_feedback_request_rater" model="ir.rule">
        <field name="name">Feedback request: rater sees own invitations</field>
        <field name="model_id" ref="model_aic_hrm_feedback_request"/>
        <field name="groups" eval="[(4, ref('aic_hrm_base.group_hrm_user'))]"/>
        <field name="domain_force">[('rater_user_id', '=', user.id)]</field>
    </record>

    <!-- Managers may INVITE raters and withdraw invitations, but never
         read individual request rows: pre-threshold per-invite status
         would leak who has (not) spoken. Progress shows only as an
         aggregate count on the review itself. -->
    <record id="rule_feedback_request_manager_write" model="ir.rule">
        <field name="name">Feedback request: manager invites for their line</field>
        <field name="model_id" ref="model_aic_hrm_feedback_request"/>
        <field name="groups" eval="[(4, ref('aic_hrm_base.group_hrm_manager'))]"/>
        <field name="domain_force">[('review_id.employee_id', 'child_of', user.employee_id.ids)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_feedback_request_admin" model="ir.rule">
        <field name="name">Feedback request: admin unrestricted</field>
        <field name="model_id" ref="model_aic_hrm_feedback_request"/>
        <field name="groups" eval="[(4, ref('aic_hrm_base.group_hrm_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Calibration: manager-room only -->
    <record id="rule_calibration_company" model="ir.rule">
        <field name="name">Calibration session: multi-company</field>
        <field name="model_id" ref="model_aic_hrm_calibration_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Plans: own for users, line for managers -->
    <record id="rule_idp_user" model="ir.rule">
        <field name="name">Plan: employee sees own</field>
        <field name="model_id" ref="model_aic_hrm_idp"/>
        <field name="groups" eval="[(4, ref('aic_hrm_base.group_hrm_user'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_idp_manager" model="ir.rule">
        <field name="name">Plan: manager covers reporting line</field>
        <field name="model_id" ref="model_aic_hrm_idp"/>
        <field name="groups" eval="[(4, ref('aic_hrm_base.group_hrm_manager'))]"/>
        <field name="domain_force">[('employee_id', 'child_of', user.employee_id.ids)]</field>
    </record>

    <record id="rule_idp_admin" model="ir.rule">
        <field name="name">Plan: admin unrestricted</field>
        <field name="model_id" ref="model_aic_hrm_idp"/>
        <field name="groups" eval="[(4, ref('aic_hrm_base.group_hrm_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_review_cycle_company" model="ir.rule">
        <field name="name">Review cycle: multi-company</field>
        <field name="model_id" ref="model_aic_hrm_review_cycle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
