<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="cron_alert_rules" model="ir.cron">
        <field name="name">Performance: run alert rules</field>
        <field name="model_id" ref="model_aic_hrm_alert_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_alert_rules()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_checkin_reminders" model="ir.cron">
        <field name="name">Performance: check-in reminders</field>
        <field name="model_id" ref="model_aic_hrm_key_result"/>
        <field name="state">code</field>
        <field name="code">model._cron_checkin_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_refresh_metric_sources" model="ir.cron">
        <field name="name">Performance: refresh metric sources</field>
        <field name="model_id" ref="model_aic_hrm_kpi_target"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_metric_sources()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
