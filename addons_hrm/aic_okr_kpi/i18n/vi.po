#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_diagnosis.py:0
msgid ""
"%(count)d linked project task(s) still open — walk the list with the team "
"and split or reassign the oldest ones."
msgstr ""
"Còn %(count)d công việc dự án liên kết chưa đóng — rà lại danh sách cùng đội"
" và tách nhỏ hoặc giao lại những việc tồn lâu nhất."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_kpi_target.py:0
msgid ""
"%(fields)s cannot change on a confirmed figure: withdraw the confirmation "
"first, with a reason."
msgstr ""
"Không thể thay đổi %(fields)s trên số đã xác nhận: hãy huỷ xác nhận kèm lý "
"do trước."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_objective.py:0
msgid ""
"%(fields)s on approved objectives change only through an approved target "
"revision."
msgstr ""
"%(fields)s trên mục tiêu đã duyệt chỉ thay đổi qua phiếu sửa chỉ tiêu đã "
"được phê duyệt."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_kpi_target.py:0
msgid ""
"%(fields)s on confirmed KPI targets change only through an approved target "
"revision."
msgstr ""
"%(fields)s trên chỉ tiêu KPI đã xác nhận chỉ thay đổi qua phiếu sửa chỉ tiêu"
" đã được phê duyệt."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_key_result.py:0
msgid ""
"%(fields)s on key results of approved objectives change only through an "
"approved target revision."
msgstr ""
"%(fields)s trên kết quả then chốt của mục tiêu đã duyệt chỉ thay đổi qua "
"phiếu sửa chỉ tiêu đã được phê duyệt."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/wizard/aic_hrm_actuals_import_wizard.py:0
msgid ""
"%(kpi)s KPI period value(s) and %(kr)s key-result check-in(s) ready to "
"import into cycle %(cycle)s."
msgstr ""
"%(kpi)s giá trị KPI theo kỳ và %(kr)s check-in kết quả then chốt sẵn sàng "
"nhập vào chu kỳ %(cycle)s.%(kpi)s giá trị kỳ KPI và %(kr)s check-in KR sẵn "
"sàng import vào chu kỳ %(cycle)s."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/wizard/aic_hrm_result_reset_wizard.py:0
msgid "%(kpi)s · %(owner)s · %(start)s - %(end)s · figure %(actual)s"
msgstr "%(kpi)s · %(owner)s · %(start)s - %(end)s · số %(actual)s"

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_objective.py:0
msgid "%(level)s-level objectives must be linked to %(unit)s."
msgstr "Mục tiêu cấp %(level)s phải gắn với %(unit)s."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_objective.py:0
msgid ""
"%(link)s: objective %(other)s belongs to cycle %(other_cycle)s, which is "
"neither this objective's cycle nor its containing cycle."
msgstr ""
"%(link)s: mục tiêu %(other)s thuộc chu kỳ %(other_cycle)s, không phải chu kỳ"
" của mục tiêu này cũng không phải chu kỳ bao ngoài."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/wizard/aic_hrm_import_wizard.py:0
msgid ""
"%(person)s's row states a total of %(stated)s; scorecard weights were scaled"
" to 100 so it can be submitted."
msgstr ""
"Dòng của %(person)s ghi tổng %(stated)s; trọng số phiếu giao đã được quy đổi"
" về 100 để có thể gửi duyệt."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/wizard/aic_hrm_import_wizard.py:0
msgid "%(person)s's scorecard weights do not add up: %(issue)s."
msgstr "Trọng số phiếu giao của %(person)s chưa khớp: %(issue)s."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_kpi_target.py:0
msgid "%(targets)s: set a metric source before pulling actuals."
msgstr "%(targets)s: hãy chọn nguồn chỉ số trước khi lấy số thực tế."

#. module: aic_okr_kpi
#: model:ir.model.fields,help:aic_okr_kpi.field_aic_hrm_checkin__confidence
msgid "1 = will miss badly, 10 = will certainly hit."
msgstr "1 = gần như trượt, 10 = chắc chắn đạt."

#. module: aic_okr_kpi
#: model:aic.hrm.framework,name:aic_okr_kpi.framework_4dx
msgid "4 Disciplines of Execution"
msgstr "4 Kỷ luật Thực thi (4DX)"

#. module: aic_okr_kpi
#: model_terms:ir.actions.act_window,help:aic_okr_kpi.action_aic_hrm_kpi
msgid ""
"A KPI record carries its full documentation form: definition, formula, "
"direction, aggregation, source and thresholds. The template library ships "
"ready-made human-capital KPIs."
msgstr ""
"Mỗi KPI mang trọn hồ sơ tài liệu: định nghĩa, công thức, chiều đo, cách tổng"
" hợp, nguồn số liệu và ngưỡng. Thư viện mẫu có sẵn bộ KPI nhân sự dựng sẵn."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_checkin.py:0
msgid "A check-in belongs to exactly one key result or one KPI target."
msgstr "Mỗi check-in thuộc đúng một kết quả then chốt hoặc một chỉ tiêu KPI."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_kpi_target.py:0
msgid ""
"A confirmed figure cannot be deleted: withdraw the confirmation first, with "
"a reason. The score depends on it."
msgstr ""
"Không thể xoá số đã xác nhận: hãy huỷ xác nhận kèm lý do trước. Điểm đánh "
"giá phụ thuộc vào số này."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_kpi_target.py:0
msgid "A lower-is-better target cannot be negative. Use 0 for zero tolerance."
msgstr ""
"Chỉ tiêu càng thấp càng tốt không được âm. Dùng 0 cho chỉ tiêu không dung "
"sai (không được xảy ra)."

#. module: aic_okr_kpi
#. odoo-python
#: code:addons/aic_okr_kpi/models/aic_hrm_kpi_target.py:0
msgid ""
"A target on a scorecard carries weight; it cannot be made tracking-only."
msgstr ""
"Chỉ tiêu đang nằm trên phiếu giao có trọng số; không thể chuyển thành chỉ số"
" chỉ theo dõi."

