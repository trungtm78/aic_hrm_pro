<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Withdrawing a confirmed figure takes it out of somebody's score, so
         the reason is asked for once, here, and kept in the audit trail. -->
    <record id="view_aic_hrm_result_reset_wizard_form" model="ir.ui.view">
        <field name="name">aic.hrm.kpi.result.reset.wizard.form</field>
        <field name="model">aic.hrm.kpi.result.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="Withdraw confirmation">
                <p>
                    These figures are part of a score. Withdrawing the
                    confirmation removes them from it until they are confirmed
                    again; the reason below is recorded and posted on the KPI.
                </p>
                <group>
                    <field name="result_ids" invisible="1"/>
                    <field name="affected_summary" readonly="1" nolabel="1"
                           colspan="2"/>
                    <field name="reason" placeholder="Why does this confirmed figure have to be taken back?"
                           nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_reset" type="object" string="Withdraw confirmation"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
