<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="aic_okr_kpi.Cockpit">
    <div class="o_aic_hrm o_action">
        <header class="o_aic_page_head">
            <div>
                <h2 class="o_aic_page_title">Leadership Cockpit</h2>
                <p class="o_aic_page_sub">Cycle health, department heatmap and the risk queue</p>
            </div>
            <select class="form-select o_aic_cycle_select" t-on-change="onCycleChange"
                    t-att-disabled="!state.cycles.length"
                    aria-label="Cycle">
                <t t-foreach="state.cycles" t-as="cycle" t-key="cycle.id">
                    <option t-att-value="cycle.id"
                            t-att-selected="cycle.id === state.cycleId ? 'selected' : undefined">
                        <t t-esc="cycle.name"/>
                    </option>
                </t>
            </select>
        </header>

        <div t-if="state.loading" class="o_aic_empty">Loading…</div>
        <div t-elif="!state.cycles.length" class="o_aic_empty">
            No open cycle yet. Create and open a performance cycle, then come back.
        </div>
        <t t-else="">
            <div class="o_aic_health_strip" t-if="state.stats">
                <div class="o_aic_stat">
                    <div class="o_aic_stat_value" t-esc="formatPercent(state.stats.overall)"/>
                    <div class="o_aic_stat_label">Overall score</div>
                </div>
                <div class="o_aic_stat">
                    <div class="o_aic_stat_value" t-esc="formatPercent(state.stats.committed)"/>
                    <div class="o_aic_stat_label">Committed objectives</div>
                </div>
                <div class="o_aic_stat">
                    <div class="o_aic_stat_value" t-esc="formatPercent(state.stats.checkinRate)"/>
                    <div class="o_aic_stat_label">Fresh check-ins</div>
                </div>
                <div class="o_aic_stat">
                    <div class="o_aic_stat_value o_aic_hrm_num" t-esc="state.stats.objectiveCount"/>
                    <div class="o_aic_stat_label">Objectives</div>
                </div>
            </div>

            <div class="o_aic_cockpit_body">
                <section class="o_aic_card">
                    <header class="o_aic_card_head">
                        <div>
                            <h5 class="o_aic_card_title">Department heatmap</h5>
                            <!-- Kept on one line on purpose: the translation
                                 key is the literal text node, so wrapping it
                                 for readability would stop it matching. -->
                            <p class="o_aic_card_sub">One tile per objective, worst first. The band comes from the cycle's thresholds, not from opinion.</p>
                        </div>
                        <div class="o_aic_legend">
                            <span class="o_aic_rag o_aic_rag_red o_aic_legend_item">
                                <span class="o_aic_rag_marker"/>Off track
                            </span>
                            <span class="o_aic_rag o_aic_rag_amber o_aic_legend_item">
                                <span class="o_aic_rag_marker"/>At risk
                            </span>
                            <span class="o_aic_rag o_aic_rag_green o_aic_legend_item">
                                <span class="o_aic_rag_marker"/>On track
                            </span>
                            <span class="o_aic_rag o_aic_rag_none o_aic_legend_item">
                                <span class="o_aic_rag_marker"/>Not scored
                            </span>
                        </div>
                    </header>

                    <div t-foreach="state.heatmapRows" t-as="row"
                         t-key="row.department" class="o_aic_dept">
                        <div class="o_aic_dept_head">
                            <div class="o_aic_dept_name">
                                <t t-esc="row.department"/>
                                <span t-if="row.isUnassigned" class="o_aic_tag_stale">
                                    needs an owner
                                </span>
                            </div>
                            <div class="o_aic_dept_counts">
                                <span t-if="row.counts.red"
                                      class="o_aic_rag o_aic_rag_red o_aic_count">
                                    <span class="o_aic_rag_marker"/>
                                    <t t-esc="row.counts.red"/>
                                </span>
                                <span t-if="row.counts.amber"
                                      class="o_aic_rag o_aic_rag_amber o_aic_count">
                                    <span class="o_aic_rag_marker"/>
                                    <t t-esc="row.counts.amber"/>
                                </span>
                                <span t-if="row.counts.green"
                                      class="o_aic_rag o_aic_rag_green o_aic_count">
                                    <span class="o_aic_rag_marker"/>
                                    <t t-esc="row.counts.green"/>
                                </span>
                                <span t-if="row.counts.none"
                                      class="o_aic_rag o_aic_rag_none o_aic_count">
                                    <span class="o_aic_rag_marker"/>
                                    <t t-esc="row.counts.none"/>
                                </span>
                            </div>
                            <div class="o_aic_dept_score">
                                <span class="o_aic_hrm_num"
                                      t-esc="formatPercent(row.score)"/>
                                <span class="o_aic_dept_bar">
                                    <span t-attf-style="width: {{ Math.min(100, Math.round((row.score || 0) * 100)) }}%"/>
                                </span>
                            </div>
                        </div>

                        <div class="o_aic_tile_grid">
                            <div t-foreach="row.objectives" t-as="objective"
                                 t-key="objective.id"
                                 t-attf-class="o_aic_tile o_aic_rag o_aic_rag_{{ objective.rag || 'none' }}"
                                 t-att-title="cellTitle(objective)">
                                <div class="o_aic_tile_top">
                                    <span class="o_aic_rag_marker"/>
                                    <span class="o_aic_chip_code" t-esc="objective.code"/>
                                    <span class="o_aic_chip_value o_aic_hrm_num"
                                          t-esc="formatPercent(objective.score)"/>
                                </div>
                                <div class="o_aic_tile_name" t-esc="objective.name"/>
                            </div>
                        </div>
                    </div>

                    <div t-if="!state.heatmapRows.length" class="o_aic_empty">
                        No objectives in this cycle yet — import the spreadsheet or add objectives.
                    </div>
                </section>

                <aside class="o_aic_card o_aic_risk_rail">
                    <h5 class="o_aic_card_title">Needs attention</h5>
                    <div t-foreach="state.risks" t-as="risk" t-key="risk.id"
                         class="o_aic_risk_item">
                        <span t-attf-class="o_aic_rag o_aic_rag_{{ risk.rag || 'none' }} o_aic_rag_code">
                            <span class="o_aic_rag_marker"/>
                            <span class="o_aic_chip_code" t-esc="risk.code"/>
                        </span>
                        <div class="o_aic_risk_text">
                            <div class="o_aic_risk_name" t-esc="risk.name"/>
                            <div class="o_aic_risk_meta">
                                <t t-if="risk.employee_id"><t t-esc="risk.employee_id[1]"/></t>
                                <t t-if="risk.is_stale">
                                    <span class="o_aic_tag_stale">no recent check-in</span>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div t-if="!state.risks.length" class="o_aic_empty">
                        Nothing red or stale. Keep the cadence going.
                    </div>
                </aside>
            </div>
        </t>
    </div>
</t>

</templates>
