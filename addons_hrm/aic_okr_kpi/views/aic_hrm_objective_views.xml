<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aic_hrm_objective_list" model="ir.ui.view">
        <field name="name">aic.hrm.objective.list</field>
        <field name="model">aic.hrm.objective</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'done'">
                <field name="code"/>
                <field name="name"/>
                <field name="cycle_id"/>
                <field name="level" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="weight" optional="show"/>
                <field name="kr_count" string="KRs"/>
                <field name="score" widget="percentage" optional="show"/>
                <field name="rag" widget="badge"
                       decoration-success="rag == 'green'"
                       decoration-warning="rag == 'amber'"
                       decoration-danger="rag == 'red'"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_aic_hrm_objective_form" model="ir.ui.view">
        <field name="name">aic.hrm.objective.form</field>
        <field name="model">aic.hrm.objective</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="aic_hrm_base.group_hrm_manager"/>
                    <button name="action_reset_to_draft" type="object" string="Send Back"
                            invisible="state != 'submitted'"
                            groups="aic_hrm_base.group_hrm_manager"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_self_assess" type="object" string="Self-assess"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_manager_review" type="object" string="To Manager Review"
                            class="btn-primary" invisible="state != 'self_assessed'"/>
                    <button name="action_finalize" type="object" string="Finalize"
                            class="btn-primary" invisible="state != 'manager_review'"
                            groups="aic_hrm_base.group_hrm_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="What must change this cycle?"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="cycle_id"/>
                            <field name="level"/>
                            <field name="objective_type"/>
                            <field name="priority"/>
                            <field name="visibility"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="weight"/>
                            <field name="score" widget="percentage"/>
                            <field name="rag"/>
                            <field name="parent_id"/>
                            <field name="contributes_to_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Key Results" name="krs">
                            <field name="kr_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="metric_type"/>
                                    <field name="direction" optional="show"/>
                                    <field name="baseline" optional="show"/>
                                    <field name="current"/>
                                    <field name="target"/>
                                    <field name="unit" optional="show"/>
                                    <field name="weight"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="rag" widget="badge"
                                           decoration-success="rag == 'green'"
                                           decoration-warning="rag == 'amber'"
                                           decoration-danger="rag == 'red'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_aic_hrm_objective_search" model="ir.ui.view">
        <field name="name">aic.hrm.objective.search</field>
        <field name="model">aic.hrm.objective</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="employee_id"/>
                <filter string="My Objectives" name="my"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="In Progress" name="in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="At Risk" name="at_risk" domain="[('rag', '=', 'red')]"/>
                <group>
                    <filter string="Cycle" name="group_cycle" domain="[]"
                            context="{'group_by': 'cycle_id'}"/>
                    <filter string="Department" name="group_department" domain="[]"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Owner" name="group_owner" domain="[]"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="RAG" name="group_rag" domain="[]"
                            context="{'group_by': 'rag'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aic_hrm_objective" model="ir.actions.act_window">
        <field name="name">Objectives</field>
        <field name="res_model">aic.hrm.objective</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_cycle': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set the first objective of this cycle</p>
            <p>Objectives carry weighted key results; scores roll up automatically as check-ins land.</p>
        </field>
    </record>

    <record id="view_aic_hrm_key_result_list" model="ir.ui.view">
        <field name="name">aic.hrm.key.result.list</field>
        <field name="model">aic.hrm.key.result</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="objective_id"/>
                <field name="employee_id" optional="show"/>
                <field name="current"/>
                <field name="target"/>
                <field name="unit" optional="show"/>
                <field name="progress" widget="progressbar"/>
                <field name="rag" widget="badge"
                       decoration-success="rag == 'green'"
                       decoration-warning="rag == 'amber'"
                       decoration-danger="rag == 'red'"/>
            </list>
        </field>
    </record>

    <record id="view_aic_hrm_key_result_form" model="ir.ui.view">
        <field name="name">aic.hrm.key.result.form</field>
        <field name="model">aic.hrm.key.result</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="objective_id"/>
                            <field name="employee_id"/>
                            <field name="metric_type"/>
                            <field name="direction"/>
                            <field name="unit"/>
                        </group>
                        <group>
                            <field name="baseline"/>
                            <field name="current"/>
                            <field name="target"/>
                            <field name="weight"/>
                            <field name="progress" widget="percentage"/>
                            <field name="rag"/>
                            <field name="deadline"/>
                            <field name="focus_quarters"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Milestones" name="milestones"
                              invisible="metric_type != 'milestone'">
                            <field name="milestone_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="weight"/>
                                    <field name="is_done"/>
                                    <field name="date_done"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_aic_hrm_key_result" model="ir.actions.act_window">
        <field name="name">Key Results</field>
        <field name="res_model">aic.hrm.key.result</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_aic_hrm_objectives" name="Objectives"
              parent="aic_hrm_base.menu_aic_hrm_root" sequence="20"
              action="action_aic_hrm_objective"
              groups="aic_hrm_base.group_hrm_user"/>

    <menuitem id="menu_aic_hrm_key_results" name="Key Results"
              parent="aic_hrm_base.menu_aic_hrm_root" sequence="30"
              action="action_aic_hrm_key_result"
              groups="aic_hrm_base.group_hrm_user"/>

</odoo>
